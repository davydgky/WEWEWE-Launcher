<?xml version="1.0" encoding="utf-8"?>
<!--
    Receives no events and reads no window content. It locks the screen on a double tap, draws the
    Dynamic Island over the status bar, and takes a screenshot only when "Text on screen" is tapped.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:canTakeScreenshot="true"
    android:description="@string/lock_service_description"
    android:isAccessibilityTool="false"
    android:packageNames="io.github.davydgky.launcher.none" />
