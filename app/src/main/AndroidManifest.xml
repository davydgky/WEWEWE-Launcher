<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Network access exists only for the updater (update/AppUpdater.kt), which talks to this
        repository's GitHub releases, and for the Play Store results in the search (store/PlayStore.kt,
        can be switched off), which send the search words to Google Play when hardly any installed app
        matches. CI checks that no other code opens connections, and ML Kit's usage reporting is left
        out of the build, so nothing else about searches leaves the device.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Search sources; each one is optional and only asked for when the user switches it on. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- The SMS of the last 90 days in the search and in Gemini Nano's answers; only on this device. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Documents of other apps are only visible with "all files access" (on-device file search). -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Granted by the user under Settings > Usage access; improves "recent and frequent apps". -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Velo's history and favourites; a runtime permission defined by Velo. -->
    <uses-permission android:name="io.github.davydgky.browser.permission.READ_SEARCH_DATA" />

    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Only for "Open as bubble": a bubble is a notification, whose notification itself stays hidden. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "timer 5 min" and "wecker 7:30" in the search hand the timer or alarm to the clock app. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Apps that only offer widgets. -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <!-- The clock app, for timers and alarms typed into the search. -->
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <!-- App timers of Digital Wellbeing, offered in an app's long-press menu. -->
        <intent>
            <action android:name="android.settings.action.APP_USAGE_SETTINGS" />
        </intent>
        <package android:name="io.github.davydgky.browser" />
        <package android:name="md.obsidian" />
        <!-- "Search in Google Photos" for pictures that are only in the cloud. -->
        <package android:name="com.google.android.apps.photos" />
    </queries>

    <application
        android:name=".LauncherApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Launcher"
        tools:ignore="DataExtractionRules">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/settings_title"
            android:taskAffinity="io.github.davydgky.launcher.settings"
            android:theme="@style/Theme.Settings">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

        <!--
            ML Kit reports usage metrics through Google's data transport. Without a registered backend
            the events are dropped on the device. CI checks that the backend stays out.
        -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
                tools:node="remove" />
        </service>

        <!-- Notification dots and the notifications in an app's long-press menu; only with the user's consent. -->
        <service
            android:name=".notifications.NotificationListener"
            android:exported="true"
            android:label="@string/notification_access_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- "Add to home screen" from other apps, e.g. a page from Chrome. -->
        <activity
            android:name=".home.AddShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>

        <!-- The content of a bubble from "Open as bubble"; the opened app joins its task. -->
        <activity
            android:name=".bubbles.BubbleActivity"
            android:allowEmbedded="true"
            android:documentLaunchMode="always"
            android:excludeFromRecents="true"
            android:exported="false"
            android:resizeableActivity="true"
            android:taskAffinity="io.github.davydgky.launcher.bubble"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".index.ContentIndexJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
