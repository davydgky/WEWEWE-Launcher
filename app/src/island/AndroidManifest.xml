<?xml version="1.0" encoding="utf-8"?>
<!--
    The Dynamic Island on its own: everything of the launcher's manifest except the home screen itself.
    The island, the search over any app (island, assistant gesture, tile, widget) and the settings stay;
    the launcher icon opens the settings, on the island's page.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <activity android:name=".MainActivity" tools:node="remove" />
        <activity android:name=".home.AddShortcutActivity" tools:node="remove" />

        <!-- The reminders get an icon of their own in the island app, opening out of the island. -->
        <activity-alias
            android:name=".Reminders"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/reminders_label"
            android:targetActivity=".island.IslandRemindersActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
